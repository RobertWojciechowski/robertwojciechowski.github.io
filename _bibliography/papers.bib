@article{GaR,
	abbr = {Job Market Paper},
	abstract = {I introduce Generalized Quantile Local Projections (GQLP), a novel methodology for identifying structural quantile impulse responses. Unlike existing methods that estimate conditional quantile effects, GQLP identifies causal effects on unconditional quantiles while still exploiting controls for identification. This distinction is crucial in macroeconomics as unconditional quantiles correspond to actual economic episodes like recessions, while conditional quantiles lack a clear economic interpretation. I develop a general simulation algorithm to recover true structural quantile responses in analytically intractable models. I conduct Monte Carlo experiments demonstrating that GQLP successfully recovers structural quantile impulse responses, whereas conventional conditional quantile methods can yield misleading conclusions in the presence of control variables even when the true structural shock is observed. In a growth-at-risk application, I show that financial risk shocks have strongly asymmetric effects. Using timing restrictions for identification, I find that a one-standard-deviation credit shock reduces industrial production growth by 2 percentage points in the lower tail versus 0.5 percentage points at the median. GQLP reveals left-tail-to-median response ratios of four-to-one, double those found using conventional Quantile Local Projections, indicating that standard methods underestimate the effect of financial shock on downturns. These findings suggest that stabilizing financial conditions can help prevent painful recessions without sacrificing growth during expansions.},
	author = {Robert Wojciechowski},
	title = {Identifying Unconditional Quantile Impulse Responses with an Application to Growth-at-Risk},
	pdf = {GaR.pdf},
	slides = {website_slides.pdf},
	year = {2025}, journal = {}, 
    volume = {},
    number = {},
    pages = {}}

@article{ECB,
	abbr = {ECB Working Paper},
	abstract = {This study evaluates the effectiveness of EU Cohesion Policy as an investment programme,  employing a novel dataset that links firm-level data from Orbis with project-level information from the Kohesio database. It focuses on two key questions: (1) Which firms receive EU funding? (2) How does receiving EU funding affect firm performance? By applying a logit model and a local projection difference-in-differences approach, we provide new insights into the allocation mechanisms of EU Cohesion Policy funds and their firm-level impact. Our findings show that funding tends to be allocated to firms that already perform relatively well, and that firms receiving EU funding experience a persistent productivity increase of approximately 3\% after 4 years, with smaller and more financially constrained firms experiencing relatively greater improvements. Moreover, funding targeting SME investment tends to enhance firm performance disproportionately more than other categories, whereas projects directed the green transition appear comparatively less beneficial.},
	author = {Robert Wojciechowski and {De Sanctis}, Alessandro  and Francesca Vinci and Daniel Kapp},
	pdf = {ecb_wp3099.pdf},
	slides = {RRF_and_Cohesion_Funds.pdf},
	video = {https://faculti.net/unlocking-private-investment-and-boosting-productivity-with-eu-programmes},
	title = {Unlocking Growth? EU Investment Programmes and Firm Performance},
	year = {2025}}

@article{Prod,
	abbr = {Working Paper},
	abstract ={We analyze administrative data covering the near-universe of French non-financial firms over 1997-2019. Aggregate productivity dispersion (polarization) rises only modestly, masking substantial industry heterogeneity: most manufacturing industries experience an increase in polarization, whereas in services rising and falling industries are roughly balanced, in contrast with the services-led pattern documented for other European economies. Our main contribution is to decompose the contribution to polarization from different firm dynamic factors. Contrary to traditional narratives that an increase in polarization is driven by technology developments that make it more difficult to challenge the dominance of top firms, we find that industries with larger increases in polarization did not experience greater persistence of top firms or larger declines in entry, and that polarization is driven by compositional turnover at the top boundary of the productivity distribution rather than by further advances by industry leaders. This is particularly evident in the services sector, where the productivity premium of firms that remain at the top narrows relative to the median, while turnover at the top boundary pushes polarization in the opposite direction. In particular, top dropouts tend to leave from the lower part of the upper tail, leaving behind a more selected group of top firms. A firm dynamics model with entry, exit, and incremental and radical innovation best matches the observed decomposition when polarization rises because of shocks to entry conditions, namely higher entry costs and higher volatility of entrants' productivity. Overall, the evidence is difficult to square with a "superstar firms" view and suggests that the link between technological change, firm dynamics and polarization is more complex than previously understood.},
	author = {Robert Wojciechowski and Andrea Caggese and Madalena Gaspar and Carolina Villegas-Sanchez},
	title = {New Stylised facts on Firm and Productivity Dynamics},
	%pdf = {firm_dynamics.pdf},
year = {2025}}
